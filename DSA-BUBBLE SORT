#include<iostream>
using namespace std;
int main()
{
	int arr[50],temp,i,j,n;
	cout<<"How many values? : ";
	cin>>n;
	for(i=0;i<n;i++)
	{
		cout<<"arr["<<i<<"] = ";
		cin>>arr[i];
	}
	for(i=0;i<n-1;i++)
	{
		for(j=0;j<(n-1-i);j++)
		{
			if(arr[j]>arr[j+1]){
			
			temp=arr[j];
			arr[j]=arr[j+1];
			arr[j+1]=temp;
			}
		}
	}
	cout<<"Output: "<<endl;
	for(i=0;i<n;i++){
		cout<<"arr["<<i<<"]= "<< arr[i] <<endl;
	}
	return 0;
}
